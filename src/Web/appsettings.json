{
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "LeaseSeconds": 60,
    "InitialRetryDelaySeconds": 5,
    "MaximumRetryDelaySeconds": 300,
    "ProcessedRetentionDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkerApiKey": "change-me",
  "Caching": {
    "Tasks": {
      "Enabled": true,
      "TtlSeconds": 30
    }
  }
}
